PORT=4000
HOST=127.0.0.1
NODE_ENV=development
# Development secret only; replace before using outside local development.
JWT_SECRET=stageflow-local-dev-secret
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://stageflow:stageflow@localhost:5432/stageflow
REDIS_URL=redis://localhost:6379
# Standalone Redis, one API owner per environment. Defaults to sf_<NODE_ENV>.
LIVE_NAMESPACE=sf_development
# Exact immediate proxy IPs only; blank ignores all forwarding headers.
TRUSTED_PROXIES=
# Separate fixed-window budgets. HLS reads and chunk posts do not share the ordinary API counter.
RATE_WINDOW_MS=60000
RATE_KEYS_MAX=10000
HTTP_RATE_LIMIT=240
HLS_RATE_LIMIT=240
UPLOAD_NETWORK_RATE_LIMIT=240
UPLOAD_USER_RATE_LIMIT=240
UPLOAD_ATTEMPT_RATE_LIMIT=240
GUEST_RATE_LIMIT=20
GUEST_PENDING_LIMIT=64
SOCKET_CONNECT_RATE_LIMIT=60
SOCKET_EVENT_RATE_LIMIT=600
AUTH_PENDING_LIMIT=64
# Each socket/room queue scope gets these normal and reserved cleanup budgets.
LIVE_PENDING_LIMIT=512
LIVE_PENDING_PER_KEY=32
LIVE_CLEANUP_RESERVE=128
HTTP_BODY_BYTES=16384
SOCKET_MESSAGE_BYTES=524288
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
FFMPEG_PATH=ffmpeg
DATA_ROOT=apps/api/data
VITE_API_BASE_URL=http://localhost:4000/api
VITE_WS_URL=http://localhost:4000
