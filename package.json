{
  "name": "stageflow",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter @stageflow/shared typecheck && pnpm --filter @stageflow/api typecheck && pnpm --filter @stageflow/web typecheck",
    "lint": "pnpm -r lint",
    "build": "pnpm --filter @stageflow/api build && pnpm --filter @stageflow/web build",
    "dev": "node scripts/dev.mjs",
    "test": "pnpm --filter @stageflow/shared test && pnpm --filter @stageflow/web test && pnpm --filter @stageflow/api test",
    "test:unit": "pnpm --filter @stageflow/shared test && pnpm --filter @stageflow/web test",
    "test:integration": "pnpm --filter @stageflow/api test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm format:check"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
