{
  "name": "stageflow",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter @stageflow/shared typecheck && pnpm --filter @stageflow/api typecheck && pnpm --filter @stageflow/web typecheck",
    "lint": "pnpm lint:config && pnpm -r lint",
    "build": "pnpm --filter @stageflow/api build && pnpm --filter @stageflow/web build",
    "dev": "node scripts/dev.mjs",
    "test": "pnpm --filter @stageflow/shared test && pnpm --filter @stageflow/web test && pnpm --filter @stageflow/api test",
    "test:unit": "pnpm --filter @stageflow/shared test && pnpm --filter @stageflow/web test",
    "test:integration": "pnpm --filter @stageflow/api test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm format:check",
    "lint:config": "node scripts/lint.mjs eslint.config.js scripts",
    "test:tooling": "node --test scripts/*.test.mjs",
    "check:artifacts": "node scripts/check-artifacts.mjs",
    "smoke:live": "pnpm --filter @stageflow/api exec dotenv -e ../../.env -- node ../../scripts/smoke-live.mjs",
    "check:release": "pnpm test:tooling && pnpm check && pnpm check:artifacts && pnpm smoke:live",
    "check:affected": "node scripts/check-affected.mjs",
    "audit:check": "node scripts/audit.mjs"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
