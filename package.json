{
  "name": "stageflow",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "node scripts/checks.mjs typecheck",
    "lint": "pnpm lint:config && pnpm -r lint",
    "build": "node scripts/checks.mjs build",
    "build:production": "node scripts/checks.mjs build:production",
    "dev": "node scripts/dev.mjs",
    "test": "node scripts/checks.mjs test",
    "test:unit": "node scripts/checks.mjs test:unit",
    "test:integration": "node scripts/checks.mjs test:integration",
    "check": "node scripts/checks.mjs check",
    "lint:config": "node scripts/lint.mjs eslint.config.js scripts deploy",
    "test:tooling": "node --test scripts/*.test.mjs",
    "check:artifacts": "node scripts/check-artifacts.mjs",
    "smoke:live": "pnpm --filter @stageflow/api exec dotenv -e ../../.env -- node ../../scripts/smoke-live.mjs",
    "smoke:broadcast": "pnpm --filter @stageflow/api exec dotenv -e ../../.env -- node ../../scripts/smoke-broadcast.mjs",
    "check:release": "node scripts/checks.mjs check:release",
    "check:affected": "node scripts/check-affected.mjs",
    "audit:check": "node scripts/audit.mjs",
    "shared:prepare": "node scripts/shared-build.mjs ensure"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
