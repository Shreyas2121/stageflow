{
  "name": "@stageflow/shared",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.check.json",
    "build": "node ../../scripts/shared-build.mjs build",
    "dev": "node ../../scripts/shared-build.mjs watch",
    "lint": "node ../../scripts/lint.mjs src *.config.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "5.0.5"
  }
}
