{
  "name": "@stageflow/api",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^11.2.8",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/platform-socket.io": "^11.2.8",
    "@nestjs/typeorm": "^12.0.2",
    "@nestjs/websockets": "^11.2.8",
    "@stageflow/shared": "workspace:*",
    "express": "5.2.1",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  },
  "scripts": {
    "test": "node ../../scripts/shared-build.mjs ensure && dotenv -e ../../.env -- vitest run",
    "typecheck": "node ../../scripts/shared-build.mjs ensure && tsc -p tsconfig.check.json",
    "lint": "node ../../scripts/lint.mjs src *.config.ts",
    "dev": "node ../../scripts/dev.mjs api",
    "build": "node ../../scripts/shared-build.mjs ensure && nest build",
    "migration:run": "dotenv -e ../../.env -- typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "dotenv-cli": "^11.1.0",
    "ts-node": "^10.9.2",
    "vitest": "5.0.5"
  }
}
