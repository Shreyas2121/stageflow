    "dev": "node ../../scripts/dev.mjs web",
    "build": "node ../../scripts/shared-build.mjs ensure && node ../../scripts/build-web.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  }
}
