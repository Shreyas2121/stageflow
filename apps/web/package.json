{
  "name": "@stageflow/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@stageflow/shared": "workspace:*",
    "@tanstack/react-query": "^5.105.0",
    "hls.js": "1.7.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "socket.io-client": "^4.8.4",
    "zustand": "^5.0.16"
  },
  "scripts": {
    "test": "node ../../scripts/shared-build.mjs ensure && vitest run",
    "typecheck": "node ../../scripts/shared-build.mjs ensure && tsc -p tsconfig.check.json",
