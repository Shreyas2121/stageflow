[Unit]
Description=StageFlow dedicated private PostgreSQL and Redis
Requires=docker.service
After=docker.service
RequiresMountsFor=/srv/stageflow
AssertPathIsMountPoint=/srv/stageflow
OnFailure=stageflow-alert@%n.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/etc/stageflow
ExecStart=/bin/sh /opt/stageflow/current/deploy/infra.sh start
ExecStop=/bin/sh /opt/stageflow/current/deploy/infra.sh stop
TimeoutStartSec=120s
TimeoutStopSec=60s
LogNamespace=stageflow

[Install]
WantedBy=multi-user.target
