[Unit]
Description=StageFlow dependency and disk check
OnFailure=stageflow-alert@%n.service

[Service]
Type=oneshot
User=stageflow
Group=stageflow
WorkingDirectory=/opt/stageflow/current
EnvironmentFile=/etc/stageflow/stageflow.env
ExecStart=/opt/stageflow/node/bin/node deploy/ops.mjs health
TimeoutStartSec=20s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
CPUQuota=10%
MemoryMax=128M
TasksMax=16
LogNamespace=stageflow
