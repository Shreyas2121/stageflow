# Existing Hostinger services. Do not generate a new Redis password; copy the one already configured.
# Do not point this file at another project's database. Backup and restore ignore a mismatched URL and refuse.
NODE_ENV=production
HOST=127.0.0.1
PORT=4100
JWT_SECRET=CHANGE_ME_64_HEX_CHARACTERS
CORS_ORIGIN=https://stage.shreyasrasaikar.cloud
DATABASE_URL=postgresql://stageflow_app:CHANGE_ME_POSTGRES_HEX_SECRET@127.0.0.1:5432/stageflow_db
DATABASE_POOL_MAX=4
REDIS_URL=redis://:CHANGE_ME_REDIS_HEX_SECRET@127.0.0.1:6381/0
LIVE_NAMESPACE=sf_production
TRUSTED_PROXIES=127.0.0.1
DATA_ROOT=/srv/stageflow/media
FFMPEG_PATH=/usr/bin/ffmpeg
# Google stays disabled until the separate real-provider acceptance passes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
STUN_URL=stun:stun.l.google.com:19302
# Restricted IP-allowlisted trial only. Do not distribute long-lived TURN credentials publicly.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
ENCODER_GLOBAL_LIMIT=1
ENCODER_PRINCIPAL_LIMIT=1
FFMPEG_THREADS=1
RECORDING_MAX_MS=900000
RECORDING_MAX_BYTES=268435456
STORAGE_MAX_BYTES=1073741824
MIN_FREE_BYTES=2147483648
GUEST_RECORDING_LIMIT=3
GUEST_STORAGE_BYTES=268435456
PASSWORD_WORKER_LIMIT=1
PASSWORD_QUEUE_LIMIT=4
PASSWORD_ACCOUNT_LIMIT=10
RATE_WINDOW_MS=60000
RATE_KEYS_MAX=1000
HTTP_RATE_LIMIT=240
HLS_RATE_LIMIT=240
UPLOAD_NETWORK_RATE_LIMIT=240
UPLOAD_USER_RATE_LIMIT=240
UPLOAD_ATTEMPT_RATE_LIMIT=240
GUEST_RATE_LIMIT=20
GUEST_PENDING_LIMIT=16
SOCKET_CONNECT_RATE_LIMIT=60
SOCKET_EVENT_RATE_LIMIT=600
AUTH_PENDING_LIMIT=16
LIVE_PENDING_LIMIT=128
LIVE_PENDING_PER_KEY=32
LIVE_CLEANUP_RESERVE=32
HTTP_BODY_BYTES=16384
SOCKET_MESSAGE_BYTES=524288
